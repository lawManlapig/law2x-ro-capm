{
  "_version": "1.84.0",
  "sap.app": {
    "id": "eqinv",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:lrop",
      "version": "1.24.0",
      "toolsId": "29173e89-8616-47c7-a604-cbf09bf2110f"
    },
    "dataSources": {
      "mainService": {
        "uri": "/odata/v4/ro/",
        "type": "OData",
        "settings": {
          "annotations": [],
          "odataVersion": "4.01"
        }
      }
    },
    "crossNavigation": {
      "inbounds": {
        "law2xTrainingSO-manageROEquipments": {
          "semanticObject": "law2xTrainingSO",
          "action": "manageROEquipments",
          "title": "{{law2xTrainingSO-manageROEquipments.flpTitle}}",
          "subTitle": "{{law2xTrainingSO-manageROEquipments.flpSubtitle}}",
          "signature": {
            "parameters": {},
            "additionalParameters": "allowed"
          }
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "dependencies": {
      "minUI5Version": "1.148.0",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.fe.templates": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "eqinv.i18n.i18n"
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      },
      "@i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "uri": "i18n/i18n.properties"
      }
    },
    "resources": {
      "css": []
    },
    "routing": {
      "config": {},
      "routes": [
        {
          "pattern": ":?query:",
          "name": "EquipmentTypesSetList",
          "target": "EquipmentTypesSetList"
        },
        {
          "pattern": "EquipmentTypesSet({key}):?query:",
          "name": "EquipmentTypesSetObjectPage",
          "target": "EquipmentTypesSetObjectPage"
        },
        {
          "pattern": "EquipmentTypesSet({key})/equipments({key2}):?query:",
          "name": "EquipmentsSetObjectPage",
          "target": "EquipmentsSetObjectPage"
        }
      ],
      "targets": {
        "EquipmentTypesSetList": {
          "type": "Component",
          "id": "EquipmentTypesSetList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "contextPath": "/EquipmentTypesSet",
              "variantManagement": "Page",
              "navigation": {
                "EquipmentTypesSet": {
                  "detail": {
                    "route": "EquipmentTypesSetObjectPage"
                  }
                }
              },
              "controlConfiguration": {
                "@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": {
                    "type": "ResponsiveTable"
                  }
                }
              }
            }
          }
        },
        "EquipmentTypesSetObjectPage": {
          "type": "Component",
          "id": "EquipmentTypesSetObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "editableHeaderContent": false,
              "contextPath": "/EquipmentTypesSet",
              "navigation": {
                "equipments": {
                  "detail": {
                    "route": "EquipmentsSetObjectPage"
                  }
                }
              }
            }
          }
        },
        "EquipmentsSetObjectPage": {
          "type": "Component",
          "id": "EquipmentsSetObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "editableHeaderContent": false,
              "contextPath": "/EquipmentTypesSet/equipments"
            }
          }
        }
      }
    }
  },
  "sap.fiori": {
    "registrationIds": [],
    "archeType": "transactional"
  },
  "sap.fe": {
    "app": {
      "enableLazyLoading": true
    }
  },
  "sap.cloud": {
    "public": true,
    "service": "ROAppRouter"
  }
}
